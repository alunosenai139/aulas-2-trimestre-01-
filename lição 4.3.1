<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cores em Espanhol</title>
    <style>
        img {
            height: 200px;
            width: 200px;
            display: block;
            margin-bottom: 15px;
        }
        .rojo { color: red; }
        .azul { color: #0099ff; }
        .anaranjado { color: orange; }
        .verde { color: darkgreen; }
        .amarillo { color: gold; }
    </style>
</head>
<body>

    <h1>Aprendendo cores em espanhol!</h1>

    <h3 class="rojo">Rojo</h3>
    <img src="vermelho.png" alt="Vermelho">

    <h3 class="azul">Azul</h3>
    <img src="azul.jpg" alt="Azul">

    <h3 class="anaranjado">Anaranjado</h3>
    <img src="laranja.jpg" alt="Laranja">

    <h3 class="verde">Verde</h3>
    <img src="verde.jpg" alt="Verde">

    <h3 class="amarillo">Amarillo</h3>
    <img src="amarelo.jpg" alt="Amarelo">

</body>
</html>
